APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# MySQL connection string (e.g. mysql+pymysql://root:password@localhost:3306/creator_marketplace)
# Falls back safely to sqlite:///./marketplace.db if MySQL is not available locally
DATABASE_URL=sqlite:///./marketplace.db

JWT_SECRET_KEY=creatorai-super-secure-jwt-secret-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (Optional OpenAI / Claude / Gemini API key)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
